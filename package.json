{
  "name": "schoolhop-pwa",
  "version": "1.0.25",
  "private": true,
  "description": "SchoolHop browser PWA static frontend checks.",
  "scripts": {
    "build": "npm run ios:build",
    "ios:build": "node scripts/build-capacitor-web.js",
    "ios:sync": "npm run ios:build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "lint": "eslint app/static/app.js app/static/service-worker.js tests/frontend/*.mjs",
    "test": "node --test tests/frontend/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "globals": "^15.15.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/push-notifications": "^7.0.7"
  }
}
