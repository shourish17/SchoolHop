{
  "appId": "com.schoolhop.app",
  "appName": "SchoolHop",
  "webDir": "build/capacitor",
  "server": {
    "iosScheme": "https",
    "hostname": "localhost"
  },
  "ios": {
    "contentInset": "automatic"
  },
  "android": {
    "allowMixedContent": false,
    "loggingBehavior": "none",
    "adjustMarginsForEdgeToEdge": "disable"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
