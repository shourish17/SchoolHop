SCHOOLHOP_API_PORT=8088
POSTGRES_DB=schoolhop
POSTGRES_USER=schoolhop
POSTGRES_PASSWORD=replace-with-a-unique-local-password
DATABASE_URL=postgresql://schoolhop:replace-with-a-unique-local-password@postgres:5432/schoolhop
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
RAW_LOCATION_RETENTION_MINUTES=120
LOCATION_STALE_SECONDS=90
SAFETY_TIMEOUT_MINUTES=180
ENVIRONMENT=production
EXPOSE_DEVELOPMENT_VERIFICATION_CODES=false

# Optional external notification providers. Keep these separate from Family AI.
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_PATH=
APNS_USE_SANDBOX=true

# Email verification and invitations. Use AgentMail or SMTP; do not commit real keys.
EMAIL_PROVIDER=smtp
AGENTMAIL_API_KEY=
AGENTMAIL_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# PWA maps. The browser key must be HTTP-referrer restricted to the SchoolHop domain.
PUBLIC_SITE_URL=https://schoolhop.shourish.com
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_ROUTES_API_KEY=
